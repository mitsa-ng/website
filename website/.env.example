# Database (required) — PostgreSQL connection string.
# Use the pooled connection string from your provider (e.g. Neon, Supabase).
DATABASE_URL=

# Public site URL (optional). Used for sitemap, robots, OG tags. Has a sensible fallback.
NEXT_PUBLIC_SITE_URL=

# Admin init token (optional, recommended for production).
# When set, POST /api/admin/init requires an X-Admin-Init-Token header matching this value,
# preventing the first random visitor from minting an admin key on a fresh deploy.
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Remove it after the initial admin key has been generated.
ADMIN_INIT_TOKEN=

# CORS allowlist (optional, recommended for production).
# Comma-separated list of origins permitted to make cross-origin API requests
# (e.g. a separately-hosted admin web UI: "https://admin.example.com").
# When unset, falls back to permissive "*" for local development.
# Note: the Electron desktop admin app sends requests without an Origin header
# and is unaffected by CORS; the real auth gate is always the X-Api-Key check.
ALLOWED_ORIGINS=
